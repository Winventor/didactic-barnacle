{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#1a1f2e" },
        { "slug": "paper", "name": "Paper", "color": "#f7f5f1" },
        { "slug": "accent", "name": "Accent", "color": "#0f5c4c" },
        { "slug": "muted", "name": "Muted", "color": "#5c6578" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Source Serif 4\", \"Iowan Old Style\", Palatino, serif"
        },
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "\"DM Sans\", \"Segoe UI\", sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--display)"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "#ffffff"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
