# Database
DATABASE_URL="postgresql://juridisch:juridisch@localhost:5432/juridisch?schema=public"

# Redis (achtergrondwachtrij bronopvragingen)
REDIS_URL="redis://localhost:6379"

# HTTP client
LEGAL_USER_AGENT="JuridischOnderzoeksplatform/1.0 (legal-research; contact@example.com)"

# EUR-Lex webservice (gratis registratie vereist)
# https://eur-lex.europa.eu/content/help/data-reuse/webservice.html
EUR_LEX_USERNAME=""
EUR_LEX_PASSWORD=""

# Optionele LLM-provider (standaard: rule-based mock, geen externe API)
LLM_PROVIDER="mock"
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Privacy: stuur geen dossiergegevens naar externe AI zonder expliciete toestemming
ALLOW_EXTERNAL_LLM="false"

# Bewaartermijn dossiers (dagen)
DOSSIER_RETENTION_DAYS="365"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
